{
  "name": "@codesentra/cli",
  "version": "0.0.0",
  "private": true,
  "description": "CodeSentra command line: Sentra Pulse and Sentra Scan",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "codesentra": "./dist/main.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node bundle/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bundle": "node bundle/build.mjs"
  },
  "dependencies": {
    "@codesentra/checks": "workspace:*",
    "@codesentra/core": "workspace:*",
    "@codesentra/sandbox": "workspace:*",
    "@codesentra/scan": "workspace:*",
    "@codesentra/ssrf": "workspace:*",
    "playwright-core": "1.64.1",
    "@codesentra/parsers": "workspace:*"
  },
  "devDependencies": {
    "@codesentra/fixture-harness": "workspace:*",
    "esbuild": "0.28.2"
  }
}
