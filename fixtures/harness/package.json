{
  "name": "@codesentra/fixture-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "codesentra-fixture-harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gate": "vitest run --reporter=verbose",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "node-forge": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fixtures/blank": "workspace:*",
    "@fixtures/broken-route": "workspace:*",
    "@fixtures/console-throw": "workspace:*",
    "@fixtures/env-undefined": "workspace:*",
    "@fixtures/healthy": "workspace:*",
    "@fixtures/localhost-leak": "workspace:*",
    "@types/node-forge": "1.3.14",
    "playwright-core": "1.64.1"
  }
}
