{
    "name": "codesentra/php-notes-api",
    "description": "A notes API in PHP with Slim",
    "type": "project",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.14",
        "guzzlehttp/psr7": "2.4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
