# CodeSentra — production environment template (self-hosted app tier).
#
# Copy to a file your secret manager renders (e.g. /etc/codesentra/app.env) and fill every
# value. This drives infra/deploy/app.compose.yml (api, worker-pulse, worker-link, web, and
# the one-shot migrate job). worker-scan runs on its own gVisor VM with its own env file —
# see infra/deploy/worker-scan.compose.yml and docs/deployment.md.
#
# Lines marked `# secret` must come from your secret manager, never from version control.
# Every integration a service declares is REQUIRED in production (packages/config): a missing
# or placeholder value makes that service refuse to start. Leave truly optional lines unset.

# ---- Images (pushed tags from your registry) ------------------------------------------
API_IMAGE=registry.example.com/codesentra-api:TAG
WORKER_PULSE_IMAGE=registry.example.com/codesentra-worker-pulse:TAG
WORKER_LINK_IMAGE=registry.example.com/codesentra-worker-link:TAG
WEB_IMAGE=registry.example.com/codesentra-web:TAG

# ---- Core (all app services) ----------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# Postgres. The app connects as a role that must NOT bypass RLS (docs/runbook.md §3).
DATABASE_URL=postgres://codesentra_app:PASSWORD@db.example.com:5432/codesentra   # secret
# 32-byte base64 key for sealed secrets at rest. ENCRYPTION_KEY_PREVIOUS enables rotation.
ENCRYPTION_KEY=                      # secret
ENCRYPTION_KEY_PREVIOUS=             # secret, only during a key rotation
# Public origin of the web app, and the API's bind address.
PUBLIC_APP_URL=https://app.example.com
API_HOST=0.0.0.0
API_PORT=4000
# Signs sessions/state. Random, >= 32 chars.
SESSION_SECRET=                      # secret

# ---- Object storage (S3-compatible) : api, worker-pulse, worker-scan ------------------
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=codesentra
S3_ACCESS_KEY_ID=                    # secret
S3_SECRET_ACCESS_KEY=                # secret
# The endpoint browsers reach for direct zip uploads (ADR 0024); often the same as S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=https://s3.example.com

# ---- GitHub App : api, worker-link, worker-scan ---------------------------------------
# Create with scripts/github-app/setup.mjs; see docs/github-app-setup.md.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=              # secret (PEM; \n-escaped single line is accepted)
GITHUB_WEBHOOK_SECRET=               # secret (>= 16 chars)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=            # secret
GITHUB_APP_SLUG=codesentra

# ---- GitHub sign-in OAuth : api -------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=          # secret

# ---- Email (Resend) : api, worker-link ------------------------------------------------
EMAIL_TRANSPORT=resend
EMAIL_FROM=CodeSentra <noreply@example.com>
EMAIL_PROVIDER_API_KEY=              # secret

# ---- Slack alerts : api, worker-link --------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=                 # secret

# ---- Anthropic (report model) : worker-link, worker-scan ------------------------------
ANTHROPIC_API_KEY=                   # secret
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# LLM cost cap: an org's input+output tokens per month before Scan records a gap instead of
# calling the model. 0 disables it.
LLM_MONTHLY_TOKEN_CAP=0

# ---- Web -> API ------------------------------------------------------------------------
# Internal URL the web server uses to reach the API (not public).
API_INTERNAL_URL=http://api:4000

# ---- Telemetry (optional) --------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
