{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", "out-fixed/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "SANDBOX_*",
        "DOCKER_HOST",
        "TESTCONTAINERS_*",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "PLAYWRIGHT_BROWSERS_PATH",
        "CHROMIUM_EXECUTABLE"
      ]
    },
    "@codesentra/web#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@fixtures/blank#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@fixtures/broken-route#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@fixtures/console-throw#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@fixtures/env-undefined#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@fixtures/healthy#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@fixtures/localhost-leak#typecheck": {
      "dependsOn": ["^build", "build"]
    }
  }
}
