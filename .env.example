# CodeSentra environment. Every variable is validated at startup by packages/config;
# services refuse to start with missing or placeholder values (e.g. "change-me").
# Each service validates only the variables it uses (see SERVICE_ENV in packages/config).
# In production every integration a service uses is required. In development and test
# an integration (S3, GitHub OAuth, GitHub App, email, Slack, Anthropic) may be left
# entirely blank: the feature it powers then answers 501 "not configured" (ADR 0007).

# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Local infrastructure (read by infra/docker-compose.yml only, not by services) ---
POSTGRES_PASSWORD=

# --- Core ---
# Postgres 16 connection string. Local: matches infra/docker-compose.yml.
DATABASE_URL=postgres://codesentra:<POSTGRES_PASSWORD>@localhost:5432/codesentra
# >= 32 random characters. Generate: openssl rand -base64 48
SESSION_SECRET=
# 32 bytes, base64. Encrypts bypass tokens and GitHub installation data. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Public URL of the web app, e.g. http://localhost:3000
PUBLIC_APP_URL=

# --- API ---
API_HOST=127.0.0.1
API_PORT=4000
# Where the web app's server reaches the API (the browser only talks to the web app).
API_INTERNAL_URL=http://127.0.0.1:4000

# --- Object storage (MinIO locally; S3 or R2 in production) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=codesentra
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- LLM (worker-link only) ---
ANTHROPIC_API_KEY=
# Model id used for report prose and feature proposals.
ANTHROPIC_MODEL=

# --- GitHub ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Numeric GitHub App id.
GITHUB_APP_ID=
# PEM private key; newlines may be written as \n.
GITHUB_APP_PRIVATE_KEY=
# >= 16 characters; must match the App's webhook secret.
GITHUB_WEBHOOK_SECRET=
# Override only for GitHub Enterprise Server.
GITHUB_OAUTH_BASE_URL=https://github.com
GITHUB_API_BASE_URL=https://api.github.com

# --- Notifications ---
# resend (production) | outbox (development/test only: writes each email as JSON to EMAIL_OUTBOX_DIR)
EMAIL_TRANSPORT=resend
EMAIL_OUTBOX_DIR=.outbox
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Sandbox (worker-scan) ---
# runsc (gVisor, preferred) or runc (plain Docker with --network none + seccomp + read-only root).
SANDBOX_RUNTIME=runsc

# --- Optional observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
