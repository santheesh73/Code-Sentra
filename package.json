{
  "name": "codesentra",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fixtures:build": "turbo run build --filter=./fixtures/apps/*",
    "fixtures:serve": "pnpm --filter @codesentra/fixture-harness start",
    "gate:phase0": "pnpm --filter @codesentra/fixture-harness gate",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:fixtures": "docker compose --env-file .env -f infra/docker-compose.yml --profile fixtures up -d --build --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml --profile fixtures down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
